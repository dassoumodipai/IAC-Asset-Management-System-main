{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header Strict-Transport-Security "max-age=31536000"

	# API goes straight to Node so the original https scheme and client IP reach it (TRUST_PROXY_HOPS=1).
	handle /api/* {
		request_body {
			max_size 12MB
		}
		reverse_proxy api:3000
	}

	handle {
		reverse_proxy web:80
	}
}
