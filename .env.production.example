# Copy to .env.production on the server (never commit it) and fill every value.
# Used by: docker compose --env-file .env.production -f infra/docker-compose.prod.yml up -d --build
# Generate each secret separately with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# or: openssl rand -hex 32
# Hex values are URL-safe, which the database passwords require.

# Public hostname; its DNS A record must point at this server. APP_ORIGIN becomes https://$DOMAIN.
DOMAIN=assets.example.org
# Let's Encrypt account / expiry-notice address.
ACME_EMAIL=it@example.org

# Database (local container). Owner runs migrations; app is the restricted runtime login.
# The app password is applied only when the database volume is first created.
POSTGRES_OWNER_PASSWORD=GENERATE_HEX
POSTGRES_APP_PASSWORD=GENERATE_SEPARATE_HEX

# Keep these permanently in a password manager/secret store. Changing or losing
# TOTP_ENCRYPTION_KEY or AUTH_MAIL_ENCRYPTION_KEY breaks MFA and queued email.
TOTP_ENCRYPTION_KEY=GENERATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
AUTH_MAIL_ENCRYPTION_KEY=GENERATE_SEPARATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS
CSRF_SECRET=GENERATE_SEPARATE_32_RANDOM_BYTES_AS_64_HEX_CHARACTERS

# SMTP. Google Workspace: smtp.gmail.com, 465, true, full address + app password.
# Transactional providers (Brevo, SES, SendGrid...): use their SMTP host/port/credentials.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=assets@example.org
SMTP_PASSWORD=
SMTP_FROM=IAC Asset Portal <assets@example.org>

PORTAL_NOTICE_VERSION=1
